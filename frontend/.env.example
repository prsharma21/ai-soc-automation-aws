# Copy to .env.local and adjust. Never put secrets in VITE_* variables:
# they are embedded in the browser bundle.

# Base URL of the FastAPI backend (placeholder).
VITE_API_BASE_URL=http://localhost:8000

# "true" serves deterministic synthetic data from the browser.
# "false" calls the FastAPI backend; failures are shown, never replaced with mock data.
VITE_USE_MOCK_DATA=true
