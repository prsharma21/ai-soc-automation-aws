# Copy to `.env` for local development. Never commit `.env` or real credentials.
# AWS credentials are NOT configured here: use IAM roles (deployed) or
# `aws login` / AWS SSO profiles (local). Secrets belong in AWS Secrets Manager.

# --- Backend (FastAPI) ---
# Environment label: development | staging | production
APP_ENV=development
# Service name reported by GET /health
APP_NAME=ai-soc-automation-aws
# Bind address and port for `uvicorn app.main:app`
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated browser origins allowed by CORS (the Vite dev server by default)
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite; values are embedded in the browser bundle, so NEVER put secrets here) ---
# Backend base URL used by the frontend API client (also documented in frontend/.env.example)
VITE_API_BASE_URL=http://localhost:8000
# true = in-browser demo data, false = call the live backend
VITE_USE_MOCK_DATA=true

# --- AWS (later phases) ---
# Region for Bedrock, S3 and other AWS services
AWS_REGION=your-aws-region

# --- Database (later phase; not used yet) ---
# Connection string for the investigation/incident store, e.g. postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=
